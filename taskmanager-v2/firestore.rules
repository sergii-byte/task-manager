rules_version = '2';

// ordify — Firestore security rules
//
// Phase 1: each signed-in user can read/write only their own data document
// at /userdata/{uid}. Nothing else is accessible. Production-mode default
// (deny-all) stays in force for every other path.
//
// Phase 5 (team) will replace the single-doc model with granular collections
// and assignee-scoped rules.

service cloud.firestore {
  match /databases/{database}/documents {

    match /userdata/{uid} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

  }
}
