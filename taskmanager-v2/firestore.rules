rules_version = '2';

// ordify — Firestore security rules
//
// /userdata/{uid}  — the hub's blob (clients, matters, time, invoices,
//                    profile). Readable/writable only by its owner.
//
// /tasks/{id}      — one document per task. The hub (ownerId) has full
//                    access to their own tasks; an assignee can read and
//                    update the tasks assigned to their email address.
//                    Teammates never gain access to /userdata.

service cloud.firestore {
  match /databases/{database}/documents {

    match /userdata/{uid} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    match /tasks/{taskId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.ownerId
            || request.auth.token.email == resource.data.assigneeEmail);

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerId;

      allow update: if request.auth != null
        && (request.auth.uid == resource.data.ownerId
            || request.auth.token.email == resource.data.assigneeEmail);

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerId;
    }

    // /shares/{shareId} — a sanitized, read-only status snapshot for one
    // client (no rates, amounts, invoices or internal notes). The document
    // id is an unguessable 128-bit token; anyone who has the link can GET
    // the document, but listing the collection is forbidden — so the token
    // in the URL is the only way in. Only the hub can write.
    match /shares/{shareId} {
      allow get: if true;
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if request.auth != null
        && request.auth.uid == resource.data.ownerId
        && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerId;
    }

    // /shares/{shareId}/comments/{id} — the two-way thread on a status page.
    // The thread lives *under* the share, so reading or listing it already
    // requires the unguessable token — same trust model as the page itself.
    //
    // Writers are told apart by the parent share's ownerId: the hub posts as
    // 'hub', anyone else (an anonymous client session) posts as 'client', and
    // client posts are only accepted while the hub leaves commentsEnabled on.
    match /shares/{shareId}/comments/{commentId} {
      function share() {
        return get(/databases/$(database)/documents/shares/$(shareId)).data;
      }
      function isHub() {
        return request.auth != null && share().ownerId == request.auth.uid;
      }

      allow get, list: if true;

      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/shares/$(shareId))
        && request.resource.data.keys().hasOnly(['taskId', 'author', 'text', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt == request.time
        && (request.resource.data.taskId == null
            || request.resource.data.taskId is string)
        && (
             (request.resource.data.author == 'hub' && isHub())
             || (request.resource.data.author == 'client'
                 && !isHub()
                 && share().commentsEnabled == true)
           );

      // Posted messages are immutable; only the hub can prune a thread.
      allow update: if false;
      allow delete: if isHub();
    }

  }
}
