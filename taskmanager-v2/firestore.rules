rules_version = '2';

// ordify — Firestore security rules
//
// /userdata/{uid}  — the hub's blob (clients, matters, time, invoices,
//                    profile). Readable/writable only by its owner.
//
// /tasks/{id}      — one document per task. The hub (ownerId) has full
//                    access to their own tasks; an assignee can read and
//                    update the tasks assigned to their email address.
//                    Teammates never gain access to /userdata.

service cloud.firestore {
  match /databases/{database}/documents {

    match /userdata/{uid} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    match /tasks/{taskId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.ownerId
            || request.auth.token.email == resource.data.assigneeEmail);

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerId;

      allow update: if request.auth != null
        && (request.auth.uid == resource.data.ownerId
            || request.auth.token.email == resource.data.assigneeEmail);

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerId;
    }

  }
}
